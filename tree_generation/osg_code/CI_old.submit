Universe = vanilla
Executable = CI.sh
Arguments = $(process)


Error = log/osgJob.$(process).err
Output = log/osgJob.$(process).out
Log = log/osgJob.$(process).log


should_transfer_files = YES
when_to_transfer_output = ON_EXIT
Notification = never
transfer_input_files= graphs, clonal, parameters.in
transfer_output_files = results

# Require nodes that can access the correct OSG modules
Requirements = (HAS_MODULES =?= true)

request_cpus    = 1 
request_memory  = 4GB
request_disk    = 4GB

Queue 960
